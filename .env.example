# OLLAMA_HOST: URL of the Ollama API server.
# Defaults to http://localhost:11434 if not set.
OLLAMA_HOST="http://localhost:11434"

# OLLAMA_MODEL: The model name to use for inference.
# Defaults to deepseek-r1:8b if not set.
OLLAMA_MODEL="deepseek-r1:8b"

# GEMINI_API_KEY: Required for Gemini AI API calls (if using Gemini backend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
